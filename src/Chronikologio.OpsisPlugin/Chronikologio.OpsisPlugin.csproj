<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <!-- The assembly name ends in "Plugin": Opsis loads every *Plugin.dll it finds in a plugin folder. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chronikologio.Core/Chronikologio.Core.csproj" />
    <ProjectReference Include="../Chronikologio.UI/Chronikologio.UI.csproj" />
    <Reference Include="Opsis.UI"><HintPath>../../libs/Opsis.UI.dll</HintPath><Private>true</Private></Reference>
    <!-- The contract is shared with the host (Opsis loads it in its default context), so it is not copied next to the plugin. -->
    <Reference Include="OpsisNewsCrawler.Plugin.Abstractions">
      <HintPath>../../libs/OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../data/**/*.json;../../data/**/*.tsv" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/images/**/*.jpg;../../data/images/**/*.jpeg;../../data/images/**/*.png" Link="data/images/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
